generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  SUPERVISOR
  ACCOUNTANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum WorkStatus {
  DRAFT
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  FINALIZED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

enum EntryKind {
  STANDARD
  ADJUSTMENT
}

enum OnboardingStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
}

enum VatPeriodicity {
  MONTHLY
  QUARTERLY
  NOT_APPLICABLE
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  displayName  String
  active       Boolean      @default(true)
  totpEnabled  Boolean      @default(false)
  totpSecretEncrypted String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships Membership[]
  sessions     Session[]
  requested    ApprovalRequest[] @relation("RequestedBy")
  decisions    ApprovalDecision[]
  auditEvents  AuditLog[]
  drafts       AccountingDraft[] @relation("DraftCreatedBy")
  onboardingUpdates CompanyOnboarding[] @relation("OnboardingUpdatedBy")
}

model Company {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  taxCode               String?
  fourEyesRequired      Boolean      @default(false)
  strongApprovalRequired Boolean     @default(true)
  approverTotpRequired  Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  approvalRequests      ApprovalRequest[]
  auditLogs             AuditLog[]
  drafts                AccountingDraft[]
  onboarding            CompanyOnboarding?
}

model CompanyOnboarding {
  companyId              String           @id @db.Uuid
  countryCode            String?          @db.VarChar(2)
  legalForm              String?
  accountingRegime       String?
  vatPeriodicity         VatPeriodicity?
  managementSoftware     String?
  hasChartOfAccounts     Boolean?
  hasOpeningBalances     Boolean?
  currentStep            Int              @default(1)
  status                 OnboardingStatus @default(IN_PROGRESS)
  version                Int              @default(1)
  updatedById            String           @db.Uuid
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  updatedBy              User             @relation("OnboardingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status])
}

model Membership {
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId, role])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  userId       String    @db.Uuid
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  mfaVerifiedAt DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AccountingDraft {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @db.Uuid
  description     String
  status          WorkStatus   @default(DRAFT)
  version         Int          @default(1)
  entryKind       EntryKind    @default(STANDARD)
  adjustsEntryId  String?      @db.Uuid
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  finalizedAt     DateTime?
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("DraftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  adjustsEntry    AccountingDraft? @relation("Adjustment", fields: [adjustsEntryId], references: [id], onDelete: Restrict)
  adjustments     AccountingDraft[] @relation("Adjustment")
  lines           AccountingLine[]
  approvals       ApprovalRequest[]

  @@index([companyId, status])
}

model AccountingLine {
  id          String          @id @default(uuid()) @db.Uuid
  draftId     String          @db.Uuid
  accountCode String
  description String
  debitCents  BigInt          @default(0)
  creditCents BigInt          @default(0)
  draft       AccountingDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId])
}

model ApprovalRequest {
  id                   String       @id @default(uuid()) @db.Uuid
  companyId            String       @db.Uuid
  draftId              String       @db.Uuid
  objectType           String
  objectVersion        Int
  objectHash           String
  status               WorkStatus   @default(PENDING_APPROVAL)
  requestedById        String       @db.Uuid
  requiresStrongConfirm Boolean     @default(true)
  requiresSecondApproval Boolean    @default(false)
  snapshot             Json
  diff                 Json
  anomalies            Json
  rejectionReason      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  approvedAt           DateTime?
  finalizedAt          DateTime?
  company              Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  draft                AccountingDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  requestedBy          User         @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decisions            ApprovalDecision[]

  @@index([companyId, status])
  @@unique([draftId, objectVersion])
}

model ApprovalDecision {
  id                String               @id @default(uuid()) @db.Uuid
  approvalRequestId String               @db.Uuid
  actorId           String               @db.Uuid
  decision          ApprovalDecisionType
  reason            String?
  observedHash      String
  ipAddress         String?
  createdAt         DateTime             @default(now())
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  actor             User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([approvalRequestId, decision])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  actorId       String?  @db.Uuid
  eventType     String
  entityType    String
  entityId      String
  beforeValue   Json?
  afterValue    Json?
  reason        String?
  ipAddress     String?
  correlationId String
  previousHash  String?
  entryHash     String
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@unique([companyId, entryHash])
}
