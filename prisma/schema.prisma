generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  SUPERVISOR
  ACCOUNTANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum WorkStatus {
  DRAFT
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  FINALIZED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

enum EntryKind {
  STANDARD
  ADJUSTMENT
}

enum OnboardingStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
}

enum VatPeriodicity {
  MONTHLY
  QUARTERLY
  NOT_APPLICABLE
}

enum PartnerKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  passwordHash        String
  displayName         String
  active              Boolean             @default(true)
  totpEnabled         Boolean             @default(false)
  totpSecretEncrypted String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  memberships         Membership[]
  sessions            Session[]
  requested           ApprovalRequest[]   @relation("RequestedBy")
  decisions           ApprovalDecision[]
  auditEvents         AuditLog[]
  drafts              AccountingDraft[]   @relation("DraftCreatedBy")
  onboardingUpdates   CompanyOnboarding[] @relation("OnboardingUpdatedBy")
  chartImports        ChartImport[]       @relation("ChartImportCreatedBy")
  businessPartners    BusinessPartner[]   @relation("BusinessPartnerCreatedBy")
  chartSelections     ChartSelection[]    @relation("ChartSelectionCreatedBy")
}

model Company {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  taxCode                String?
  fourEyesRequired       Boolean            @default(false)
  strongApprovalRequired Boolean            @default(true)
  approverTotpRequired   Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  memberships            Membership[]
  approvalRequests       ApprovalRequest[]
  auditLogs              AuditLog[]
  drafts                 AccountingDraft[]
  onboarding             CompanyOnboarding?
  chartImports           ChartImport[]
  businessPartners       BusinessPartner[]
  chartSelections        ChartSelection[]
}

model BusinessPartner {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  kind          PartnerKind
  displayName   String            @db.VarChar(200)
  taxCode       String?           @db.VarChar(16)
  vatNumber     String?           @db.VarChar(20)
  email         String?           @db.VarChar(254)
  phone         String?           @db.VarChar(40)
  address       String?           @db.VarChar(300)
  countryCode   String            @default("IT") @db.VarChar(2)
  status        WorkStatus        @default(DRAFT)
  version       Int               @default(1)
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  finalizedAt   DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("BusinessPartnerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvals     ApprovalRequest[]

  @@index([companyId, status])
  @@index([companyId, displayName])
  @@unique([companyId, taxCode])
  @@unique([companyId, vatNumber])
}

model ChartImport {
  id             String                  @id @default(uuid()) @db.Uuid
  companyId      String                  @db.Uuid
  sourceFileName String
  fileHash       String
  rowCount       Int
  status         WorkStatus              @default(DRAFT)
  version        Int                     @default(1)
  createdById    String                  @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  finalizedAt    DateTime?
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("ChartImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines          ChartAccountDraftLine[]
  approvals      ApprovalRequest[]
  openingBalanceDrafts AccountingDraft[] @relation("OpeningBalanceChart")
  operationalSelections ChartSelection[]

  @@unique([companyId, fileHash])
  @@index([companyId, status])
}

model ChartSelection {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  chartImportId String            @db.Uuid
  status        WorkStatus        @default(DRAFT)
  version       Int               @default(1)
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  finalizedAt   DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chartImport   ChartImport       @relation(fields: [chartImportId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("ChartSelectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvals     ApprovalRequest[]

  @@index([companyId, status, finalizedAt])
  @@index([chartImportId])
}

model ChartAccountDraftLine {
  id          String      @id @default(uuid()) @db.Uuid
  importId    String      @db.Uuid
  code        String      @db.VarChar(40)
  name        String      @db.VarChar(200)
  accountType String?     @db.VarChar(80)
  parentCode  String?     @db.VarChar(40)
  position    Int
  chartImport ChartImport @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, code])
  @@index([importId, position])
}

model CompanyOnboarding {
  companyId          String           @id @db.Uuid
  countryCode        String?          @db.VarChar(2)
  legalForm          String?
  accountingRegime   String?
  vatPeriodicity     VatPeriodicity?
  managementSoftware String?
  hasChartOfAccounts Boolean?
  hasOpeningBalances Boolean?
  currentStep        Int              @default(1)
  status             OnboardingStatus @default(IN_PROGRESS)
  version            Int              @default(1)
  updatedById        String           @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  updatedBy          User             @relation("OnboardingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status])
}

model Membership {
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId, role])
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  userId        String    @db.Uuid
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  mfaVerifiedAt DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AccountingDraft {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  description    String
  status         WorkStatus        @default(DRAFT)
  version        Int               @default(1)
  entryKind      EntryKind         @default(STANDARD)
  adjustsEntryId String?           @db.Uuid
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  finalizedAt    DateTime?
  sourceType     String?           @db.VarChar(40)
  sourceFileName String?           @db.VarChar(255)
  sourceFileHash String?           @db.VarChar(64)
  sourceChartImportId String?       @db.Uuid
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("DraftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  adjustsEntry   AccountingDraft?  @relation("Adjustment", fields: [adjustsEntryId], references: [id], onDelete: Restrict)
  adjustments    AccountingDraft[] @relation("Adjustment")
  lines          AccountingLine[]
  approvals      ApprovalRequest[]
  sourceChartImport ChartImport?    @relation("OpeningBalanceChart", fields: [sourceChartImportId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@unique([companyId, sourceFileHash])
}

model AccountingLine {
  id          String          @id @default(uuid()) @db.Uuid
  draftId     String          @db.Uuid
  accountCode String
  description String
  debitCents  BigInt          @default(0)
  creditCents BigInt          @default(0)
  draft       AccountingDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId])
}

model ApprovalRequest {
  id                     String             @id @default(uuid()) @db.Uuid
  companyId              String             @db.Uuid
  draftId                String?            @db.Uuid
  chartImportId          String?            @db.Uuid
  businessPartnerId      String?            @db.Uuid
  chartSelectionId       String?            @db.Uuid
  objectType             String
  objectVersion          Int
  objectHash             String
  status                 WorkStatus         @default(PENDING_APPROVAL)
  requestedById          String             @db.Uuid
  requiresStrongConfirm  Boolean            @default(true)
  requiresSecondApproval Boolean            @default(false)
  snapshot               Json
  diff                   Json
  anomalies              Json
  rejectionReason        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  approvedAt             DateTime?
  finalizedAt            DateTime?
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  draft                  AccountingDraft?   @relation(fields: [draftId], references: [id], onDelete: Restrict)
  chartImport            ChartImport?       @relation(fields: [chartImportId], references: [id], onDelete: Restrict)
  businessPartner        BusinessPartner?   @relation(fields: [businessPartnerId], references: [id], onDelete: Restrict)
  chartSelection         ChartSelection?    @relation(fields: [chartSelectionId], references: [id], onDelete: Restrict)
  requestedBy            User               @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decisions              ApprovalDecision[]

  @@unique([draftId, objectVersion])
  @@unique([chartImportId, objectVersion])
  @@unique([businessPartnerId, objectVersion])
  @@unique([chartSelectionId, objectVersion])
  @@index([companyId, status])
}

model ApprovalDecision {
  id                String               @id @default(uuid()) @db.Uuid
  approvalRequestId String               @db.Uuid
  actorId           String               @db.Uuid
  decision          ApprovalDecisionType
  reason            String?
  observedHash      String
  ipAddress         String?
  createdAt         DateTime             @default(now())
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  actor             User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([approvalRequestId, decision])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  actorId       String?  @db.Uuid
  eventType     String
  entityType    String
  entityId      String
  beforeValue   Json?
  afterValue    Json?
  reason        String?
  ipAddress     String?
  correlationId String
  previousHash  String?
  entryHash     String
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, entryHash])
  @@index([companyId, createdAt])
}
